<?xml version="1.0" encoding="UTF-8"?>
<!-- WiX v4 installer for the Windows release folder. Built by tools/build.sh windows-msi.
     Variables passed with -d: Version, BundleDir, IconFile. -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Penumbra" Manufacturer="Penumbra" Version="$(Version)"
           UpgradeCode="{F4A4016E-8085-49E8-92F2-1A0519EC2B65}" Scope="perMachine" Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer version of Penumbra is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon.ico" SourceFile="$(IconFile)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Penumbra" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <!-- Every file of the Flutter release folder, keeping its folder layout. -->
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(BundleDir)\**" />
    </ComponentGroup>

    <Component Id="StartMenuShortcut" Directory="ProgramMenuFolder">
      <Shortcut Id="AppShortcut" Name="Penumbra" Description="Non-destructive photo editor"
                Target="[INSTALLFOLDER]penumbra.exe" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon.ico" />
      <RegistryValue Root="HKCU" Key="Software\Penumbra" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Feature Id="Main" Title="Penumbra" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
  </Package>
</Wix>
